# Copy to `.env`. Real environment variables always win over this file, so a
# container orchestrator or a CI secret beats a checked-out copy.

APP_NAME=Rainier
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_MAX_BODY=2097152

DATABASE_URL=sqlite::memory:

# sync | memory | database
QUEUE_DRIVER=sync
QUEUE_DEFAULT=default

# log | file | memory
MAIL_DRIVER=log
MAIL_FROM=hello@example.com
MAIL_FROM_NAME=Rainier

RUST_LOG=info
