#!/usr/bin/env bash
# Pre-commit gate. Same two commands as the GitHub Actions clippy job and
# the fmt check CI fails closed on (main self-heals only after the push).
# Output: step, then the command, then ok.
# This file does not rewrite the tree.
#
# Git runs it only when core.hooksPath is .githooks. In the devenv checkout,
# `make rust-hooks` (also run by `make clone` and `make init`) sets that.
# A standalone clone: `git config core.hooksPath .githooks`.
# `git commit --no-verify` is the one bypass.
set -euo pipefail

if [[ -t 1 ]]; then
	BOLD=$'\e[1m'; RED=$'\e[31m'; GREEN=$'\e[32m'; BLUE=$'\e[34m'; RESET=$'\e[0m'
else
	BOLD=""; RED=""; GREEN=""; BLUE=""; RESET=""
fi

step() { echo; echo "${BOLD}${BLUE}==> $*${RESET}"; }
ok()   { echo "${GREEN}✓${RESET} $*"; }
die()  { echo "${RED}✗${RESET} $*" >&2; exit 1; }

files=()
diff_out="$(git diff --cached --name-only --diff-filter=ACM -- '*.rs' 'Cargo.toml' 'Cargo.lock' 'rustfmt.toml')"
while IFS= read -r line; do
	[[ -n "$line" ]] && files+=("$line")
done <<< "$diff_out"

if [[ ${#files[@]} -eq 0 ]]; then
	exit 0
fi

# Toolchain. A plain `git commit` has none of the Makefile's environment: the
# first `cargo` on PATH may be Homebrew's, which ignores rustup, and rustup's
# default may be older than this project's `rust-version`. Either stops both
# checks at "requires rustc X" on a tree that is fine. So prefer rustup's
# cargo, and when nothing has chosen a toolchain (no RUSTUP_TOOLCHAIN, no
# rust-toolchain file) and the default is too old, use the newest installed
# one that matches `rust-version`.
if [[ -x "${HOME}/.cargo/bin/cargo" ]]; then
	PATH="${HOME}/.cargo/bin:${PATH}"
fi
if [[ -z "${RUSTUP_TOOLCHAIN:-}" && ! -f rust-toolchain.toml && ! -f rust-toolchain ]] \
	&& command -v rustup >/dev/null 2>&1 && [[ -f Cargo.toml ]]; then
	want="$(sed -n 's/^rust-version *= *"\([0-9.]*\)".*/\1/p' Cargo.toml | head -n 1)"
	have="$(cargo --version 2>/dev/null | awk '{print $2}')"
	if [[ -n "$want" && -n "$have" && "$(printf '%s\n%s\n' "$want" "$have" | sort -V | head -n 1)" != "$want" ]]; then
		pick="$(rustup toolchain list | awk '{print $1}' | grep -E "^${want//./\\.}(\.[0-9]+)?-" | sort -V | tail -n 1 || true)"
		[[ -n "$pick" ]] || die "this project needs Rust ${want} and rustup has only ${have}: rustup toolchain install ${want} --component clippy rustfmt"
		export RUSTUP_TOOLCHAIN="$pick"
	fi
fi

command -v cargo >/dev/null 2>&1 || die "missing required command: cargo"

step "cargo fmt --all --check"
cargo fmt --all --check
ok "fmt clean"

# `--all-features` because a lint only fires in code that is compiled, and
# the driver crates are behind features. Same invocation as CI.
step "cargo clippy --workspace --all-targets --all-features -- -D warnings"
cargo clippy --workspace --all-targets --all-features -- -D warnings
ok "clippy clean"
